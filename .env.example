# FoodBridge Environment Configuration Template

APP_NAME="FoodBridge"
APP_ENV="development" # development | production
API_V1_PREFIX="/api"

# JWT Authentication
SECRET_KEY="super-secret-foodbridge-jwt-token-key-2026-prod-grade"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (Defaults to out-of-the-box SQLite; or set your PostgreSQL connection string)
DATABASE_URL="sqlite:///./foodbridge.db"
# DATABASE_URL="postgresql://foodbridge_user:password123@localhost:5432/foodbridge"

# AI Integration
GEMINI_API_KEY=""

# Cloudinary / Image Storage (Optional)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

